{
  "name": "email-cadence-monorepo",
  "version": "1.0.0",
  "description": "Email cadence system with Next.js, NestJS, and Temporal.io",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/worker"
  ],
  "scripts": {
    "dev": "concurrently \"yarn dev:web\" \"yarn dev:api\" \"yarn dev:worker\"",
    "dev:web": "yarn workspace @cadence/web dev",
    "dev:api": "yarn workspace @cadence/api start:dev",
    "dev:worker": "yarn workspace @cadence/worker start:dev",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.3.3"
  }
}
